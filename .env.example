# Copy to .env and fill in. Never commit the real file - .gitignore covers it.

# Dashboard > Developers > API keys. Test mode keys start with sk_test_.
STRIPE_SECRET_KEY=sk_test_...

# Dashboard > Developers > Webhooks > your endpoint > Signing secret.
# One secret per endpoint. The secret from a different endpoint verifies
# nothing and produces the same 400 as an attack, so check this first when
# every event is rejected.
STRIPE_WEBHOOK_SECRET=whsec_...

# The price to sell. Dashboard > Product catalogue > your product > Pricing.
STRIPE_PRICE_ID=price_...

SUCCESS_URL=http://localhost:8000/api/checkout/success
CANCEL_URL=http://localhost:8000/api/checkout/cancel

# Checkout's language. Leave empty to let Stripe read the browser's
# Accept-Language, which is what a consumer product wants. Set it (en, fr,
# ja, zh ...) to pin one language regardless of who is looking.
CHECKOUT_LOCALE=

DATABASE_PATH=unlocks.db

# How old a signature may be, in seconds. Stripe's own default is 300.
WEBHOOK_TOLERANCE_SECONDS=300
